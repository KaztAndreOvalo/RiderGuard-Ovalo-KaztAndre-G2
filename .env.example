# Copy this file to .env and fill in your own values. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL (local) - or paste your Supabase connection details here
DB_NAME=riderguard_db
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432
# Use "require" for Supabase
DB_SSLMODE=prefer
